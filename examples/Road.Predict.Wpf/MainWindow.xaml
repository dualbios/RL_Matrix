<Window x:Class="Road.Predict.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Road.Predict.Wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel LastChildFill="True">
        <StackPanel Orientation="Vertical">
            <Button Click="Accelerate_OnClick" Content="Accelerate"/>
            <Button Click="Break_OnClick" Content="Break"/>
            <HeaderedContentControl Header="Distance">
                <TextBlock Text="{Binding Distance}" />
            </HeaderedContentControl>
            <HeaderedContentControl Header="Leader Speed">
                <TextBlock Text="{Binding LeaderSpeed}" />
            </HeaderedContentControl>
            <HeaderedContentControl Header="Follower Speed">
                <TextBlock Text="{Binding FollowerSpeed}" />
            </HeaderedContentControl>
        </StackPanel>
        <Canvas>
            <Ellipse Width="5" Height="5" Fill="Blue">
                <Canvas.Left>
                    <Binding Path="FollowerPosition" />
                </Canvas.Left>
                <Canvas.Top>50</Canvas.Top>
            </Ellipse>

            <Ellipse Width="5" Height="5" Fill="Red">
                <Canvas.Left>
                    <Binding Path="LeaderPosition" />
                </Canvas.Left>
                <Canvas.Top>150</Canvas.Top>
            </Ellipse>
        </Canvas>
    </DockPanel>
</Window>